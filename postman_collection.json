                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"admin123\",\n  \"newPassword\": \"admin123_baru\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "password"]
            },
            "description": "Mengubah password admin. Membutuhkan verifikasi password lama dan password baru minimal 6 karakter."

    {
      "name": "2. Autentikasi Admin",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-save JWT Token ke variable environment dan collection",
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.environment.set(\"token\", res.data.token);",
                  "    pm.collectionVariables.set(\"token\", res.data.token);",
                  "    console.log(\"✅ Token JWT admin berhasil disimpan!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login untuk Admin. Token JWT akan otomatis diekstrak dan disimpan ke variable `{{token}}` melalui Test script."
          },
          "response": []
        },
        {
          "name": "Get Profile Admin (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Mendapatkan profil admin yang sedang login berdasarkan token JWT."
          },
          "response": []
        },
        {
